# ============================================================
# Backend environment variables — EXAMPLE (do NOT commit real values)
# Copy to `backend/.env` and fill in your own secrets.
# ============================================================

# --- MongoDB (required) ---
# Get this from https://cloud.mongodb.com → Connect → Drivers
MONGO_URL=mongodb+srv://fanta:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=fantacalcio

# --- JWT auth (required, min 32 chars) ---
# Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_WITH_A_RANDOM_HEX_STRING_AT_LEAST_32_CHARACTERS_LONG

# --- Email provider (choose ONE) ---
# Option A (self-host): Resend direct — get key from https://resend.com/api-keys
RESEND_API_KEY=re_XXXXXXXXXX
EMAIL_FROM=Fantacalcio <noreply@yourdomain.com>

# Option B (Emergent dev/preview only): Emergent managed proxy
# EMERGENT_EMAIL_KEY=ek_xxxxxxxx

# --- Optional email settings ---
EMAIL_FROM_NAME=Fantacalcio Manager
# EMAIL_REPLY_TO=support@yourdomain.com

# --- Optional: public URL of your deployed frontend (used in email templates) ---
# APP_PUBLIC_URL=https://fantacalcio.vercel.app

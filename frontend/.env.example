# ============================================================
# Frontend environment variables — EXAMPLE
# Copy to `frontend/.env` and fill in your own values.
# ============================================================

# --- Backend URL (required) ---
# Locally: http://localhost:8001
# Production (self-hosted): your Render URL, e.g. https://fantacalcio-backend.onrender.com
EXPO_PUBLIC_BACKEND_URL=https://fantacalcio-backend.onrender.com
